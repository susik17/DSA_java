class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        # optimal => apply sliding window => dupliacte found -> reduce window size
        seen = {}
        left,max_length = 0,0
        for right,ch in enumerate(s):
            #window shrink => move pointer next to the dupliacte element
            #seen[ch]>=left => to avoid backward movement of left pointer

            if ch in seen and seen[ch]>=left:
                left = seen[ch]+1
            seen[ch] = right
            max_length = max(max_length,right-left+1)
        return max_length
            





